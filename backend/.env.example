# ── Database ─────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=inventBridge

# ── Server ────────────────────────────────────────
PORT=3000

# ── Authentication ────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
# Separate secret for refresh tokens — use a different value from JWT_SECRET
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars

# ── Cloudinary ────────────────────────────────────
# Get these from https://cloudinary.com/console
# NEVER commit real credentials to Git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Frontend origin (CORS) ────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Email / SMTP (optional — emails are skipped when not set) ─────────
# Use any SMTP provider: Gmail, Resend, SendGrid, Mailgun, etc.
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=InventBridge <no-reply@inventbridge.com>

# ── OpenAI ────────────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
# NEVER commit the real key to Git.
OPENAI_API_KEY=
# Model — gpt-4o-mini is fast + cost-efficient; upgrade to gpt-4o for richer output
OPENAI_MODEL=gpt-4o-mini

# ── Google OAuth ──────────────────────────────────
# Get from https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Frontend URL — where users are redirected after Google auth
CLIENT_URL=http://localhost:5173
